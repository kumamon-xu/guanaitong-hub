# Only reviewed source, configuration, tests and public documentation belong in Git.
/*
!/.gitignore
!/.gitattributes
!/.github/
!/.githooks/
!/README.md
!/CHANGELOG.md
!/SECURITY.md
!/CONTRIBUTING.md
!/package.json
!/package-lock.json
!/tsconfig.json
!/vite.config.ts
!/eslint.config.mjs
!/index.html
!/assets/
!/docs/
!/electron/
!/scripts/
!/src/
!/tests/

# Dependencies, bundles, installers and generated reports
node_modules/
dist/
dist-electron/
release/
output/
artifacts/
coverage/
playwright-report/
test-results/
.playwright-cli/
.research/
.local/
.private/
tmp/
temp/
backups/
*.exe
*.dll
*.dylib
*.so
*.node
*.asar
*.zip
*.7z
*.tar
*.gz
*.blockmap
*.map
*.app/

# Personal application state, credentials, encrypted data and portable backups
vault*/
state.json
addresses.enc
session-*.enc
*.db
*.db-*
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*
*.enc
*.gathub
*.gataddr
.env
.env.*
*.key
*.pem
*.p12
*.pfx
*.jks
*.keystore
*.mobileprovision

# Intermediate diagnostics and editor / OS metadata
*.log
*.tmp
*.bak
*.orig
*.swp
result.json
latest.json
*-diagnostics.json
.DS_Store
._*
Thumbs.db
Desktop.ini
